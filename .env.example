# OpenRouter API key for the wedding Q&A chat (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Comma-separated emails allowed to sign in to the admin dashboard
# (Daniella, Greg, and the wedding planner). Placeholders until real emails are provided.
ADMIN_EMAILS=daniella@example.com,greg@example.com,planner@example.com

# Secret for signing admin sessions. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The site's own address (production: https://greg-daniella.vercel.app)
BETTER_AUTH_URL=http://localhost:3000

# One-time code for creating admin accounts on /admin/setup. Remove it once accounts exist.
# Generate with: openssl rand -hex 12
ADMIN_SETUP_CODE=
